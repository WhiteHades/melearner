<column grow="1" background="background" padding="32" main="center" cross="center" label="Library setup">
  <column gap="16" label="Choose Library root">
    <column gap="8">
      <text size="sm" foreground="text_muted">Library setup</text>
      <text size="heading">Bring your Courses together</text>
      <text foreground="text_muted">Choose the folder that contains your Course folders. Each direct child can become one Course, and your learning data stays on this device.</text>
    </column>
    <if test="{rootLoading}">
      <status-bar>Opening Library setup…</status-bar>
    </if>
    <else>
      <if test="{rootFailed}">
        <column gap="12">
          <alert text="{rootMessage}" />
          <row gap="8">
            <button variant="primary" on-press="retry_root" autofocus="true">Retry</button>
          </row>
        </column>
      </if>
      <else>
        <if test="{rootScanning}">
          <column gap="12">
            <if test="{rootCommitting}">
              <status-bar>Finishing the committed Library scan…</status-bar>
            </if>
            <else>
              <status-bar>Scanning root folder…</status-bar>
              <text size="sm" foreground="text_muted" label="{rootScanProgressLabel}"><span mono>{rootScanProgressLabel}</span></text>
              <if test="{rootCancelling}">
                <text size="sm" foreground="text_muted">Cancelling before commit…</text>
              </if>
              <else>
                <if test="{rootScanCancellable}">
                  <button variant="secondary" on-press="cancel_scan">Cancel scan</button>
                </if>
              </else>
            </else>
          </column>
        </if>
        <else>
          <if test="{rootPicking}">
            <status-bar>Waiting for folder selection…</status-bar>
          </if>
          <else>
            <if test="{rootScanFailed}">
              <column gap="12">
                <alert text="{rootMessage}" />
                <row gap="8">
                  <button variant="primary" on-press="retry_scan" autofocus="true">Retry scan</button>
                  <button variant="secondary" on-press="choose_root">Choose another folder</button>
                </row>
              </column>
            </if>
            <else>
              <button variant="primary" on-press="choose_root" autofocus="true">Choose root folder</button>
            </else>
          </else>
        </else>
      </else>
    </else>
  </column>
</column>
