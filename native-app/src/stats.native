<column padding="16" gap="8" background="surface" radius="md" label="Learning ledger">
    <row gap="8" cross="center">
      <text size="heading" grow="1">Learning ledger</text>
      <button size="sm" variant="ghost" on-press="dismiss_stats" autofocus="true" label="Close learning ledger">Close</button>
    </row>
    <scroll grow="1" label="Learning ledger details">
      <column gap="8">
        <if test="{statsLoading}">
          <text size="sm" foreground="text_muted">Loading Progress…</text>
        </if>
        <else>
          <if test="{statsFailed}">
            <column gap="4" label="Learning ledger error">
              <text>Learning ledger unavailable</text>
              <text size="sm" foreground="text_muted">{statsMessage}</text>
            </column>
          </if>
          <else>
            <if test="{statsReady}">
              <column gap="4" label="Learning totals">
                <text size="sm" label="{statsCourseLine}"><span mono>{statsCourseLine}</span></text>
                <text size="sm" label="{statsStructureLine}"><span mono>{statsStructureLine}</span></text>
                <text size="sm" label="{statsProgressLine}"><span mono>{statsProgressLine}</span></text>
                <text size="sm" label="{statsPercentLine}"><span mono>{statsPercentLine}</span></text>
                <text size="sm" label="{statsTimeLine}"><span mono>{statsTimeLine}</span></text>
                <text size="sm" label="{statsStorageLine}"><span mono>{statsStorageLine}</span></text>
              </column>
              <separator />
              <column gap="4" label="Learning activity">
                <text size="sm" foreground="text_muted">Last 12 weeks</text>
                <text size="sm" label="{statsActivityLine}"><span mono>{statsActivityLine}</span></text>
                <grid width="236" columns="12" gap="4" role="grid" label="Learning activity for the last 12 weeks">
                  <for each="statsActivityCells" key="date" as="day">
                    <if test="{day.levelZero}">
                      <panel width="16" height="16" background="surface_subtle" border-color="border" role="gridcell" label="{day.label}" />
                    </if>
                    <else>
                      <if test="{day.levelOne}">
                        <panel width="16" height="16" background="surface_pressed" role="gridcell" label="{day.label}" />
                      </if>
                      <else>
                        <if test="{day.levelTwo}">
                          <panel width="16" height="16" background="info" role="gridcell" label="{day.label}" />
                        </if>
                        <else>
                          <if test="{day.levelThree}">
                            <panel width="16" height="16" background="accent" role="gridcell" label="{day.label}" />
                          </if>
                          <else>
                            <panel width="16" height="16" background="text" role="gridcell" label="{day.label}" />
                          </else>
                        </else>
                      </else>
                    </else>
                  </for>
                </grid>
              </column>
              <separator />
              <column gap="4" label="Learning items by type">
                <text size="sm" foreground="text_muted">Learning items</text>
                <for each="statsMediaRows" key="kind" as="media">
                  <column gap="2">
                    <text size="sm">{media.label}</text>
                    <text size="sm" foreground="text_muted" label="{media.detail}"><span mono>{media.detail}</span></text>
                  </column>
                </for>
              </column>
              <column gap="4" label="Top Courses">
                <text size="sm" foreground="text_muted">Top Courses</text>
                <for each="statsCourseRows" key="id" as="course">
                  <column gap="2">
                    <text size="sm">{course.label}</text>
                    <text size="sm" foreground="text_muted" label="{course.detail}"><span mono>{course.detail}</span></text>
                  </column>
                </for>
              </column>
            </if>
          </else>
        </else>
      </column>
    </scroll>
</column>
