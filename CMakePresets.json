{
  "version": 10,
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Linux C++ development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpp-dev",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}
    },
    {
      "name": "linux-release",
      "inherits": "linux-dev",
      "binaryDir": "${sourceDir}/build/cpp-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "linux-dev", "configurePreset": "linux-dev"},
    {"name": "linux-release", "configurePreset": "linux-release"}
  ],
  "testPresets": [
    {"name": "linux-dev", "configurePreset": "linux-dev", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}}
  ]
}
