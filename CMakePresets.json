{
  "version": 10,
  "configurePresets": [
    {
      "name": "linux-dev",
      "displayName": "Linux C++ development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cpp-dev",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}
    },
    {
      "name": "linux-release",
      "inherits": "linux-dev",
      "binaryDir": "${sourceDir}/build/cpp-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "linux-sanitize",
      "inherits": "linux-dev",
      "binaryDir": "${sourceDir}/build/cpp-sanitize",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-dev", "configurePreset": "linux-dev"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "linux-sanitize", "configurePreset": "linux-sanitize"}
  ],
  "testPresets": [
    {"name": "linux-dev", "configurePreset": "linux-dev", "output": {"outputOnFailure": true}},
    {"name": "linux-release", "configurePreset": "linux-release", "output": {"outputOnFailure": true}},
    {
      "name": "linux-sanitize",
      "configurePreset": "linux-sanitize",
      "output": {"outputOnFailure": true},
      "environment": {"ASAN_OPTIONS": "halt_on_error=1", "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"}
    }
  ]
}
