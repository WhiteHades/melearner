pkgname=melearner-bin
pkgver=0.1.8
pkgrel=94
pkgdesc="local course learner"
arch=("x86_64")
url="https://github.com/WhiteHades/melearner"
license=("MIT")
depends=("fontconfig" "freetype2" "glibc" "libglvnd" "libx11" "wayland")
provides=("melearner=${pkgver}")
conflicts=("melearner")
options=("!strip")
source=()
sha256sums=()

package() {
  if [[ -z "${MELEARNER_NATIVE_APPDIR:-}" || ! -x "${MELEARNER_NATIVE_APPDIR}/usr/bin/melearner" ]]; then
    error "MELEARNER_NATIVE_APPDIR must point to an audited native package stage"
    return 1
  fi

  cp -a "${MELEARNER_NATIVE_APPDIR}/usr" "${pkgdir}/usr"
}
