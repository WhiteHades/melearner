{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WhiteHades/melearner/schemas/release-evidence-v1.json",
  "title": "melearner four-artifact release evidence v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "resultStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "skipped",
        "blocked",
        "not_applicable"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "sha256"
      ]
    },
    "artifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "appimage-linux-x86_64",
            "arch-linux-x86_64",
            "dmg-macos-universal",
            "msi-windows-x86_64"
          ]
        },
        "manifestPath": {
          "$ref": "#/$defs/identifier"
        },
        "manifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "$ref": "#/$defs/resultStatus"
        }
      },
      "required": [
        "id",
        "manifestPath",
        "manifestSha256",
        "status"
      ]
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceRevision": {
      "$ref": "#/$defs/sourceRevision"
    },
    "status": {
      "$ref": "#/$defs/resultStatus"
    },
    "profileSet": {
      "$ref": "#/$defs/identity"
    },
    "fixture": {
      "$ref": "#/$defs/identity"
    },
    "runtimeLock": {
      "$ref": "#/$defs/identity"
    },
    "sbom": {
      "$ref": "#/$defs/identity"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactManifest"
      },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "appimage-linux-x86_64"
              }
            }
          }
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "arch-linux-x86_64"
              }
            }
          }
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "dmg-macos-universal"
              }
            }
          }
        },
        {
          "contains": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "msi-windows-x86_64"
              }
            }
          }
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schemaVersion",
    "sourceRevision",
    "status",
    "profileSet",
    "fixture",
    "runtimeLock",
    "sbom",
    "artifacts",
    "createdAt"
  ]
}
